        "DEFAULT": { "$value": "#16233A", "$type": "color" },
        "surface": { "$value": "#1E2E47", "$type": "color" },
        "deep": { "$value": "#0B132B", "$type": "color" }
      }
    },
    "secondary": {
      "gold": {
        "dark": { "$value": "#755B18", "$type": "color" },
        "bright": { "$value": "#D4AF37", "$type": "color" },
        "muted": { "$value": "#8A6D1F", "$type": "color" }
      }
    },
    "neutral": {
