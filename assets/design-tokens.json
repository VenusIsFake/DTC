        "DEFAULT": { "$value": "#F7F5F0", "$type": "color" },
        "deep": { "$value": "#EDEAE1", "$type": "color" },
        "wash": { "$value": "#EFECE4", "$type": "color" },
        "line": { "$value": "#DCD7CB", "$type": "color" }
