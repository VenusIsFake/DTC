# Copier vers .env.local puis remplir. Ne jamais committer .env* (ignoré par git).

# --- Supabase (Project Settings → API) ---
# La plateforme n'utilise QUE la clé publique (RLS = couche d'application).
# Ne jamais ajouter la clé service_role/secret : elle contournerait toute la sécurité.
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- YouTube Data API v3 (Google Cloud → activer "YouTube Data API v3") ---
# Clé SERVEUR uniquement : ne jamais la préfixer avec NEXT_PUBLIC_
YOUTUBE_API_KEY=votre-cle-youtube

# --- Captcha anti-robots (OPTIONNEL — Cloudflare Turnstile) ---
# 1) dash.cloudflare.com → Turnstile → Add site (clé de site + clé secrète)
# 2) Supabase Dashboard → Authentication → Providers → Captcha : coller la clé SECRÈTE
# 3) Renseigner la clé de site ici (et dans Vercel → Settings → Environment Variables)
# Sans cette variable, le widget reste invisible et l'auth fonctionne sans captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Notifications email (OPTIONNEL — Resend, resend.com) ---
# 1) Créer un compte Resend → API Keys → créer une clé
# 2) Vérifier un domaine (ou garder onboarding@resend.dev pour tester, 100 emails/jour)
# Sans RESEND_API_KEY, le bouton « Notifier par email » de la console répond 503 avec un mode d'emploi.
RESEND_API_KEY=
# Expéditeur : « Dentalk Club FMDC <noreply@votre-domaine.ma> » une fois le domaine vérifié
EMAIL_FROM=Dentalk Club FMDC <onboarding@resend.dev>
# Domaine public utilisé dans les liens des emails
NEXT_PUBLIC_SITE_URL=https://dentalkclub-fmdc.vercel.app

